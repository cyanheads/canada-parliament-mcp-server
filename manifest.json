{
  "manifest_version": "0.3",
  "name": "canada-parliament-mcp-server",
  "version": "0.1.3",
  "description": "Track Canadian federal bills, MPs, House votes, and Hansard speeches via MCP. STDIO or Streamable HTTP.",
  "author": { "name": "cyanheads" },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/canada-parliament-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/canada-parliament-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "CANPARL_USER_AGENT": "${user_config.CANPARL_USER_AGENT}",
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "user_config": {
    "CANPARL_USER_AGENT": {
      "type": "string",
      "title": "HTTP User-Agent",
      "description": "Optional HTTP identification; blank uses the server default. CR/LF forbidden.",
      "required": false,
      "default": ""
    }
  }
}
